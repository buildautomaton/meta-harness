{
  "name": "@buildautomaton/agent-runtime",
  "version": "0.1.0",
  "license": "MIT",
  "description": "ACP agent runtime: plugin kernel plus a catalog of harness, session, transport, and tool plugins",
  "author": "BuildAutomaton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildautomaton/meta-harness.git",
    "directory": "packages/agent-runtime"
  },
  "homepage": "https://github.com/buildautomaton/meta-harness/tree/main/packages/agent-runtime",
  "bugs": {
    "url": "https://github.com/buildautomaton/meta-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "^1.1.4",
    "@agentclientprotocol/sdk": "^0.14.0",
    "node-sqlite3-wasm": "^0.8.57",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ]
}
