{
  "name": "@buildautomaton/local-cli",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Thin CLI that starts a meta-harness HTTP, stdio, or remote server via runtime and product-director plugins",
  "author": "BuildAutomaton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildautomaton/meta-harness.git",
    "directory": "packages/local-cli"
  },
  "homepage": "https://github.com/buildautomaton/meta-harness/tree/main/packages/local-cli",
  "bugs": {
    "url": "https://github.com/buildautomaton/meta-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "local-cli": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@buildautomaton/runtime": "workspace:*",
    "@buildautomaton/product-director": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ]
}
