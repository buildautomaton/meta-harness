{
  "name": "@buildautomaton/product-director",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Product director: work queue, artifact plugins, and tools for telling the director what was built and asking what to build next",
  "author": "BuildAutomaton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildautomaton/meta-harness.git",
    "directory": "packages/product-director"
  },
  "homepage": "https://github.com/buildautomaton/meta-harness/tree/main/packages/product-director",
  "bugs": {
    "url": "https://github.com/buildautomaton/meta-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@buildautomaton/agent-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ]
